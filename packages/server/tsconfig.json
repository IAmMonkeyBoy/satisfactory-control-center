{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // Test-only modules stay out of the production build: fixtures, byte builders,
  // and the stand-in worker the parse-client tests spawn.
  "exclude": [
    "src/**/*.test.ts",
    "src/testSupport.ts",
    "src/**/*TestSupport.ts",
    "src/**/*TestWorker.ts"
  ],
  "references": [{ "path": "../shared" }]
}
